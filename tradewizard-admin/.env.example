# Management portal environment.
#
# Fetch the values from CloudFormation exports instead of hardcoding them:
#   aws cloudformation list-exports --query "Exports[?contains(Name,'tw-dev')]"
#
# NEXT_PUBLIC_ADMIN_API_BASE_URL must end with a slash (stage "dev"/"v1" included)
#   dev:  https://<api-id>.execute-api.us-east-1.amazonaws.com/dev/
#   prod: https://<api-id>.execute-api.us-east-1.amazonaws.com/v1/
NEXT_PUBLIC_ADMIN_API_BASE_URL=

# Region of the Cognito user pool (not the API region necessarily — same here)
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# Admin app client id (tw-{env}-admin-client-id export). Public by design.
NEXT_PUBLIC_ADMIN_CLIENT_ID=
